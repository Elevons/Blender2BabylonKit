{
  "name": "b2bkit",
  "private": false,
  "version": "1.0.0",
  "author": "Jordan Elevons (Elevons LLC)",
  "homepage": "https://elevons.design",
  "type": "module",
  "description": "Babylon Level Kit — runtime engine, Project Control Panel CLI, and matching Blender add-on zip",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "blender-addon",
    "control-panel",
    "docs",
    "mcp",
    "bin",
    "templates",
    "README.md"
  ],
  "bin": {
    "b2bkit-addon-path": "bin/addon-path.js",
    "b2bkit-control-panel": "bin/control-panel.js",
    "b2bkit-mcp": "bin/mcp.js",
    "b2bkit-create": "bin/create.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/assemble-kit-package.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "@babylonjs/addons": "^9.0.0",
    "@babylonjs/core": "^9.0.0",
    "@babylonjs/gui": "^9.0.0",
    "@babylonjs/havok": "^1.3.0",
    "@babylonjs/loaders": "^9.0.0"
  },
  "devDependencies": {
    "@babylonjs/addons": "^9.0.0",
    "@babylonjs/core": "^9.0.0",
    "@babylonjs/gui": "^9.0.0",
    "@babylonjs/havok": "^1.3.0",
    "@babylonjs/loaders": "^9.0.0",
    "@webgpu/types": "^0.1.71",
    "typescript": "^5.4.0"
  }
}
