{
  "name": "@bjs/engine",
  "private": true,
  "version": "0.32.0",
  "type": "module",
  "description": "Babylon Level Kit — runtime engine, Project Control Panel CLI, and matching Blender add-on zip",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "blender-addon",
    "control-panel",
    "bin",
    "README.md"
  ],
  "bin": {
    "b2bkit-addon-path": "./bin/addon-path.mjs",
    "b2bkit-control-panel": "./bin/control-panel.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "@babylonjs/addons": "^9.0.0",
    "@babylonjs/core": "^9.0.0",
    "@babylonjs/gui": "^9.0.0",
    "@babylonjs/havok": "^1.3.0",
    "@babylonjs/loaders": "^9.0.0"
  },
  "devDependencies": {
    "@babylonjs/addons": "^9.0.0",
    "@babylonjs/core": "^9.0.0",
    "@babylonjs/gui": "^9.0.0",
    "@babylonjs/havok": "^1.3.0",
    "@babylonjs/loaders": "^9.0.0",
    "@webgpu/types": "^0.1.71",
    "typescript": "^5.4.0"
  }
}
