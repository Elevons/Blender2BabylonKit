{
  "name": "bjs-level-kit",
  "private": true,
  "version": "1.0.2",
  "author": "Jordan Elevons (Elevons LLC)",
  "homepage": "https://elevons.design",
  "type": "module",
  "workspaces": [
    "packages/*",
    "game",
    "tools/*"
  ],
  "scripts": {
    "start": "npm run dev --workspace @bjs/project-control-panel",
    "dev": "npm run dev --workspace game",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p packages/engine && tsc --noEmit -p game && node scripts/check-component-types.mjs",
    "check:components": "node scripts/check-component-types.mjs",
    "addon:pack": "node scripts/pack-blender-addon.mjs",
    "release": "node scripts/release.mjs",
    "kit:test": "node scripts/test-kit-in-project.mjs",
    "engine:build": "npm run build --workspace b2bkit",
    "deploy:playground": "node scripts/build-playground-deploy.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:trace": "node scripts/build-trace-docs.mjs",
    "docs:blender": "node scripts/build-blender-docs.mjs",
    "docs:prose": "node scripts/build-prose-docs.mjs",
    "docs:validate": "node scripts/docs/validate-docs.mjs",
    "docs:check-links": "node scripts/check-doc-links.mjs",
    "docs:serve": "npx --yes serve docs -p 4173",
    "input:gen": "node scripts/generate-input-constants.mjs",
    "mcp:build": "npm run build --workspace @bjs/mcp",
    "mcp:index": "npm run index --workspace @bjs/mcp",
    "mcp:start": "npm run start --workspace @bjs/mcp",
    "control-panel:dev": "npm run dev --workspace @bjs/project-control-panel",
    "control-panel:build": "npm run build --workspace @bjs/project-control-panel",
    "control-panel:start": "npm run start --workspace @bjs/project-control-panel"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
