{
  "name": "bjs-level-kit",
  "private": true,
  "version": "0.29.2",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/playground",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p packages/engine && tsc --noEmit -p apps/playground",
    "create": "node scripts/create-app.mjs",
    "docs:trace": "node scripts/build-trace-docs.mjs"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}