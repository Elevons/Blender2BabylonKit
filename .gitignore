# ---- Node / Vite (babylon_runtime) ----
node_modules/
dist/
dist-ssr/
.vite/
*.local

# npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# TypeScript incremental build info
*.tsbuildinfo

# Environment files
.env
.env.*
!.env.example

# ---- Python (blender_addon) ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# ---- Blender ----
# Source .blend files are kept; ignore Blender's auto-save backups.
*.blend1
*.blend2
*.blend@
*.blend.orig

# ---- Build artifacts (generated by the packaging step) ----
# These are produced by zipping the add-on / project; rebuild them, don't commit.
*.zip
packages/engine/control-panel/

# ---- Exported level assets ----
# Levels are regenerated from Blender (glb + sidecar manifest). Comment these
# out if you want to commit a sample level under public/levels/.
babylon_runtime/public/levels/*.glb
babylon_runtime/public/levels/*.scene.json

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/
