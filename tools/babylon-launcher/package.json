{
  "name": "@bjs/babylon-launcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Self-hosted Babylon.js editor hub for Blender2BabylonKit",
  "scripts": {
    "dev": "tsx server/dev.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "NODE_ENV=production node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@babylonjs/core": "^9.0.0",
    "@babylonjs/gui": "^9.0.0",
    "@babylonjs/gui-editor": "^9.0.0",
    "@babylonjs/loaders": "^9.0.0",
    "@babylonjs/node-editor": "^9.0.0",
    "@babylonjs/node-geometry-editor": "^9.0.0",
    "@babylonjs/node-particle-editor": "^9.0.0",
    "@babylonjs/node-render-graph-editor": "^9.0.0",
    "@babylonjs/smart-filters": "^9.0.0",
    "@babylonjs/smart-filters-blocks": "^9.0.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
