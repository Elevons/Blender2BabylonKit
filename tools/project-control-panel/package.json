{
  "name": "@bjs/project-control-panel",
  "private": true,
  "version": "1.0.0",
  "author": "Jordan Elevons (Elevons LLC)",
  "homepage": "https://elevons.design",
  "type": "module",
  "description": "Project Control Panel for Blender2BabylonKit apps",
  "scripts": {
    "dev": "tsx server/dev.ts",
    "control-panel:dev": "npm run dev",
    "control-panel:build": "npm run build",
    "control-panel:start": "npm run start",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "NODE_ENV=production node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
